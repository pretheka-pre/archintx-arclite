# ==========================================
# ArchintX – Arc Lite Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (development only):
DATABASE_URL=sqlite:///./arclite.db
# Production PostgreSQL (Neon / Supabase / Render):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Staff Admin Seed Account ──────────────────────────────────────────────────
# Created automatically on first startup if no staff exists.
ADMIN_EMAIL=admin@archintx.com
ADMIN_PASSWORD=ChangeThisPassword!2026

# ── Matching Engine Thresholds ────────────────────────────────────────────────
# HIGH_CONFIDENCE_THRESHOLD: score must be >= this to be "Answered" (default 0.22)
HIGH_CONFIDENCE_THRESHOLD=0.22
# LOW_CONFIDENCE_THRESHOLD: score below this = "Refused" (default 0.08)
LOW_CONFIDENCE_THRESHOLD=0.08
# AMBIGUITY_MARGIN: cross-category score gap <= this triggers "Unclear" (default 0.02)
AMBIGUITY_MARGIN=0.02

# ── CORS & API URLs ───────────────────────────────────────────────────────────
# Set FRONTEND_URL to your deployed Vercel/Netlify URL in production
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
