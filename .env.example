# ==========================================
# ArchintX – Arc Lite Environment Variables
# ==========================================

# Database Connection (Neon, Supabase, or local PostgreSQL / SQLite)
# Example PostgreSQL: postgresql://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./arclite.db

# JWT Security
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Staff Admin Credentials (Seeded on startup)
ADMIN_EMAIL=admin@archintx.com
ADMIN_PASSWORD=ArchintX2026!Secure

# Anti-Hallucination Matching Engine Parameters
HIGH_CONFIDENCE_THRESHOLD=0.25
LOW_CONFIDENCE_THRESHOLD=0.08
AMBIGUITY_MARGIN=0.05

# CORS and API URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
